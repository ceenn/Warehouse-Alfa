# Salin file ini menjadi .env lalu isi nilainya
# Connection string dari MongoDB Atlas (Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=wms_warehouse
# Kunci rahasia untuk menandatangani cookie session (isi string acak panjang)
SECRET_KEY=ganti-dengan-string-acak-yang-panjang
SESSION_HOURS=8
# Isi true bila dijalankan lewat HTTPS (mis. di Render)
COOKIE_SECURE=false
# Ambang selisih stock opname (persen) yang memicu hitung ulang
OPNAME_THRESHOLD_PCT=10
# Buat akun & data contoh otomatis saat database masih kosong
SEED_DEFAULTS=true
